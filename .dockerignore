# Keep the build context small and keep secrets out of it entirely.
.git
.github
node_modules
.nuxt
.output
dist
coverage
reports
.trivycache
.qodana

# Secrets — must never enter a build context, let alone an image layer.
.env
.env.*
!.env.example
*.pem
*.key

# Local noise
.vscode
.idea
*.log
backup.*
